##### API CONSTANTS #####

# Authenticated API user credentials
# Use these credentials for API tests that require authentication
API_AUTHENTICATED_USERNAME=your_authenticated_username_here
API_AUTHENTICATED_USER_PASSWORD=your_authenticated_password_here

# API token expiration time in seconds
# Set the token expiration duration for authenticated API requests
API_EXPIRATION_TIME=30

# Unauthenticated API user credentials
# Use these credentials for API tests that don't require authentication
API_UNAUTHENTICATED_USERNAME=your_unauthenticated_username_here
API_UNAUTHENTICATED_USER_PASSWORD=your_unauthenticated_password_here